{
  "name": "@aiicon/server",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./desktop": "./src/desktop.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aiicon/shared": "workspace:*",
