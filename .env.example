# Optional: the API server defaults to 127.0.0.1:8787
HOST=127.0.0.1
PORT=8787

# Optional: when set, the UI cannot edit the key and uses this value first.
DEEPSEEK_API_KEY=

# Optional: DeepSeek-compatible gateway.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: initial default model when no model has been saved in the UI.
DEEPSEEK_MODEL=deepseek-flash

# Optional overrides for tests and local development.
# AIICON_CONFIG_DIR=./.data
# DEEPSEEK_TIMEOUT_MS=90000
